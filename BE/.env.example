PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# SQL Server Configuration
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=ant_coffee_db
DB_USER=sa
DB_PASSWORD=123456
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Tunnel & CORS Settings
CORS_ORIGIN=*
